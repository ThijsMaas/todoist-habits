# Todoist -> Settings -> Integrations -> Developer -> API token
TODOIST_API_TOKEN=

# Must match the timezone of your Todoist account (`todoist-habits list` warns on mismatch)
TZ=Europe/Amsterdam

# Todoist filter queries selecting the tasks to track. Habits: label ("@habit") or project ("#Habits").
# Chores (optional): stats and reminders, never rescheduled or marked missed. Leave empty to disable.
HABIT_FILTER=@habit
CHORE_FILTER=

# Minutes between completion polls
POLL_INTERVAL=10

# When the midnight job runs (local time)
MIDNIGHT_TIME=00:05

# How far back to pull completions when a habit is first seen. Activity-log retention is plan
# dependent (free: ~1 week), so anything older than that would show up as missed days.
BACKFILL_DAYS=7

# x-per-week extras
# push task to next Monday once the weekly goal is met
HIDE_AFTER_GOAL=true
# add "⚠️ N more needed in D days" to the stats block
EARLY_WARNING=true
# raise to P1 while the warning is active, restore afterwards
WARN_PRIORITY=true
# rename task to "Name (2/3)"
TITLE_PROGRESS=true

# Reminders (Todoist Pro/Business) for habits and chores still due today, at these local times per priority.
# x-per-week habits only while behind schedule. Empty list = no reminders for that priority.
REMINDERS=true
REMINDER_TIMES_P1=09:00,18:00,21:30
REMINDER_TIMES_P2=18:00,21:30
REMINDER_TIMES_P3=21:00
REMINDER_TIMES_P4=21:00
# minutes before each reminder at which `run` re-checks completions, so a habit done since the last poll stays quiet
REMINDER_LEAD=2

DB_PATH=habits.db
LOG_LEVEL=INFO
